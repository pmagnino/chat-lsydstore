ANTHROPIC_API_KEY=sk-ant-...
# Sitios que pueden usar el widget, separados por coma (con y sin www)
ALLOWED_ORIGIN=https://lsydstore.com.ar,https://www.lsydstore.com.ar
# Proxies delante del backend: Cloudflare + HAProxy = 2 (HAProxy con
# "option forwardfor"). Con un solo proxy (Render, Railway...) = 1.
PROXY_HOPS=2
# Límite de consultas por IP
CHAT_RATE_LIMIT=10 per minute;100 per day
# Tope total por día sumando todas las IPs (frena a quien use muchas IPs)
GLOBAL_RATE_LIMIT=1000 per day
# Opcional: cambiar de modelo (por defecto claude-sonnet-5-5) o esfuerzo (low/medium/high)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# Cada cuántas horas se vuelve a scrapear el catálogo (0 = nunca)
CATALOG_REFRESH_HOURS=8
# Página de prueba del widget en /test (1 para prenderla mientras probás)
ENABLE_TEST_PAGE=0
# Archivo donde se guarda cada consulta (vacío = solo en los logs de Docker)
# CHAT_LOG_FILE=/app/logs/chats.jsonl
# Panel de revisión de respuestas en /admin (vacío = desactivado). Usá una
# contraseña larga: el panel muestra lo que escriben los clientes.
ADMIN_USER=admin
ADMIN_PASSWORD=
PORT=5002
# IP donde escucha el puerto 5002 (por defecto 127.0.0.1). Si HAProxy corre
# en otro servidor, poné la IP interna de este server (o 0.0.0.0).
# CHATBOT_BIND=192.168.20.X
# Cloudflare Turnstile: frena a scripts que llamen a la API directo (curl).
# La site key es pública (va también en el <script> del widget); la secret
# key es privada. Sin TURNSTILE_SECRET_KEY, Turnstile queda desactivado.
# Podés usar el mismo widget de Turnstile que Lesedife agregándole los
# dominios lsydstore.com.ar y chat.lsydstore.com.ar, o crear uno nuevo.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
